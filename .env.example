# NH투자증권 Namuh PLUG OpenAPI 앱키/시크릿 (https://www.nhplug.com 에서 발급)
NHPLUG_APP_KEY=
NHPLUG_APP_SECRET=

# 선택 사항 ------------------------------------------------------
# 시세/조회 API 도메인 (기본: 운영). 모의투자: https://moapi.nhplug.com:8443
# NHPLUG_BASE_URL=https://api.nhplug.com:8443
# 주식현재가(대체 조회) 시장구분: KRX / NXT / UNT(통합)
# NHPLUG_MARKET_CD=KRX
# 법인 고객만 필수
# NHPLUG_MAC_ADDRESS=
# API 호출 최소 간격(ms). NH Plug REST 는 초당 5회 수준 제한
# NHPLUG_MIN_INTERVAL_MS=250
# 시세 서버측 캐시(ms)
# PRICE_CACHE_MS=30000
# 키가 있어도 모의 시세(종목마스터 전일종가)로 동작시키려면 mock
# PRICE_SOURCE=mock
# 서버 바인딩 (기본 127.0.0.1:3000). 같은 네트워크의 휴대폰에서 접속하려면 HOST=0.0.0.0
# HOST=127.0.0.1
# PORT=3000
